# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Cloudflare API token for Bind Domain auto-configuration (required).
# Scopes: Zone:Read, Zone Settings:Edit, Email Routing:Edit, DNS:Edit, Email Sending:Edit.
# Zone Settings:Edit covers the zone-level Email Routing settings — routing/enable
# and the subaddressing GET/PATCH on /zones/{zone_id}/email/routing. Email Routing:Edit
# only covers the routing rules (catch-all). Missing it means 403 on those calls.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Public read-only share endpoint hostname.
SHARE_HOST=sharemail.shopless.pro
